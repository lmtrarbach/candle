<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package manifest. The release workflow replaces {VERSION}
     with candle.__version__ + ".0" (the Store needs four numbers, last one 0).
     Identity values come from Partner Center → Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Luthiano.CandleWriter"
    Publisher="CN=450E55F8-12E8-4B6D-89E7-7E61111A8F84"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Candle Writer</DisplayName>
    <PublisherDisplayName>Luthiano</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Candle" Executable="Candle.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Candle Writer"
        Description="Plan and write your novel"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="candleproject">
            <uap:DisplayName>Candle project</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.candle</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Candle is a classic desktop (Win32) program, so it runs with full trust. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
